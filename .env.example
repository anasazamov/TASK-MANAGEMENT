DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# In production set DEBUG=0 and a unique secret with at least 50 characters.
# DJANGO_SECRET_KEY=
# CSRF_TRUSTED_ORIGINS=https://tasks.example.uz
# Lokal tarmoqda istalgan IP/domen uchun (CSRF tokeni baribir tekshiriladi):
# CSRF_TRUSTED_ORIGINS=*
# TRUST_PROXY_HTTPS=1
# DB_ENGINE=postgresql
# DB_NAME=topshiriqlar
# DB_USER=topshiriqlar
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# LLM — OpenAI. STT va TTS — VoiceLab. Kalitlar faqat serverda.
OPENAI_API_KEY=
OPENAI_TASK_MODEL=gpt-5.6-sol
OPENAI_TASK_REASONING=low
VOICELAB_API_KEY=
# Gulnoza — neutral Uzbek assistant voice. Blank also uses this voice.
VOICELAB_VOICE_ID=voice_01J9NEUTRAL0000000000000001
