DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# In production set DEBUG=0 and a unique secret with at least 50 characters.
# DJANGO_SECRET_KEY=
# CSRF_TRUSTED_ORIGINS=https://tasks.example.uz
# Lokal tarmoqda istalgan IP/domen uchun (CSRF tokeni baribir tekshiriladi):
# CSRF_TRUSTED_ORIGINS=*
# TRUST_PROXY_HTTPS=1
# DB_ENGINE=postgresql
# DB_NAME=topshiriqlar
# DB_USER=topshiriqlar
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# LLM — OpenAI. STT va TTS — Muxlisa AI. Kalitlar faqat serverda.
OPENAI_API_KEY=
OPENAI_TASK_MODEL=gpt-5.6-sol
OPENAI_TASK_REASONING=low
MUXLISA_API_KEY=
# Muxlisa ovozi: 0 — ayol, 1 — erkak.
MUXLISA_SPEAKER=0

# TypeSafe (Jev): ovozli suhbatda "bu gap tizimga aytilganmi?" va bir xil ismli
# xodimlardan qaysi biri nazarda tutilganini hal qiladi. Kalitsiz ham ishlaydi:
# hamma gap qabul qilinadi, ism aniq bo'lmasa foydalanuvchidan so'raladi.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_COMMAND_MIN=0.4
# TYPESAFE_PERSON_MIN=0.85

# Topshiriq fayllari uchun S3/MinIO. Bo'sh qoldirilsa, fayllar serverdagi media/ papkasida saqlanadi.
# S3_ENDPOINT_URL=https://minio.example.uz
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=topshiriqlar
# S3_REGION=us-east-1

# Brauzer bildirishnomalari (Web Push). Kalitlarni yaratish: manage.py push_keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.uz

# Telegram Mini App va bot. Token @BotFather'dan olinadi.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=ijro_bot
# TELEGRAM_WEBHOOK_SECRET=uzun-tasodifiy-satr
# TELEGRAM_APP_URL=https://tasks.example.uz
# Telegram Web (brauzerdagi versiya) ilovani iframe ichida ochadi; shu holat uchun:
# TELEGRAM_EMBED=1

# Davomat (yo'qlama): Hikvision eshik stansiyasi (DS-KV6124-WBE1).
# Hodisalarni LAN'dagi ko'prik agent (scripts/attendance_agent.py) /attendance/hook/<secret>/
# ga uzatadi (docs/attendance.md). Uzun tasodifiy maxfiy satr kiriting; bo'sh bo'lsa endpoint o'chiq.
# ATTENDANCE_WEBHOOK_SECRET=uzun-tasodifiy-satr
# Faqat shu IP(lar)dan qabul qilish (ixtiyoriy, vergul bilan): domofon yoki agent IP:
# ATTENDANCE_ALLOWED_IPS=192.168.1.50
# Yo'qlama boshlanish soati va ogohlantirish soatlari (Toshkent vaqti):
# ATTENDANCE_DAY_START_HOUR=7
# ATTENDANCE_LATE_HOUR=9
# ATTENDANCE_ABSENT_HOUR=11
# Yuz taqqoslash (OpenCV YuNet + SFace). Modellar: python scripts/setup_face_models.py
# Model fayllari yo'q bo'lsa tizim karta-only rejimida ishlaydi.
# FACE_MODELS_DIR=
# FACE_MATCH_THRESHOLD=0.363
# Domofon kamerasining eni:bo'yi; siqilgan 704x576 kadr shu nisbatga qaytariladi (bo'sh: o'chiq):
# ATTENDANCE_FRAME_ASPECT=16:9
#
# PULL rejimi (ixtiyoriy): server domofonga o'zi ulanib alertStream o'qiydi.
# HIKVISION_HOST=192.168.1.50
# HIKVISION_PORT=80
# HIKVISION_HTTPS=0
# HIKVISION_VERIFY_TLS=0
# HIKVISION_USER=admin
# HIKVISION_PASSWORD=
# HIKVISION_ALERT_PATH=/ISAPI/Event/notification/alertStream
# ATTENDANCE_CAPTURE_DIR=

# Loglar (ixtiyoriy): fayl berilsa, konsol bilan birga aylanma faylga yoziladi.
# DJANGO_LOG_LEVEL=INFO
# DJANGO_LOG_FILE=/var/log/topshiriq.log
