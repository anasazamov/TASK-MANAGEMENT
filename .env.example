DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# In production set DEBUG=0 and a unique secret with at least 50 characters.
# DJANGO_SECRET_KEY=
# CSRF_TRUSTED_ORIGINS=https://tasks.example.uz
# Lokal tarmoqda istalgan IP/domen uchun (CSRF tokeni baribir tekshiriladi):
# CSRF_TRUSTED_ORIGINS=*
# TRUST_PROXY_HTTPS=1
# DB_ENGINE=postgresql
# DB_NAME=topshiriqlar
# DB_USER=topshiriqlar
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# LLM — OpenAI. STT va TTS — Muxlisa AI. Kalitlar faqat serverda.
OPENAI_API_KEY=
OPENAI_TASK_MODEL=gpt-5.6-sol
OPENAI_TASK_REASONING=low
MUXLISA_API_KEY=
# Muxlisa ovozi: 0 — ayol, 1 — erkak.
MUXLISA_SPEAKER=0

# Topshiriq fayllari uchun S3/MinIO. Bo'sh qoldirilsa, fayllar serverdagi media/ papkasida saqlanadi.
# S3_ENDPOINT_URL=https://minio.example.uz
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=topshiriqlar
# S3_REGION=us-east-1
